}


/* =========================
   SMART MODE TOGGLE
========================= */

function toggleSmartMode() {

    if (!isAdmin()) {
        return;
    }


    smartMode =
        !smartMode;


    const switchElement =
        document.getElementById(
            "smartSwitch"
        );


    const badge =
        document.getElementById(
            "smartBadge"
        );


    if (smartMode) {

        switchElement.classList.add(
            "on"
        );

        badge.style.display =
            "block";

    } else {

        switchElement.classList.remove(
            "on"
        );

        badge.style.display =
            "none";

    }


    document.getElementById(
        "adminMessage"
    ).textContent =
        smartMode
            ? "🧠 Smart Mode enabled."
            : "🤪 Smart Mode disabled.";

}


/* =========================
   BAN USER
========================= */

function banUser() {

    if (!isAdmin()) {
        return;
    }


    const input =
        document.getElementById(
            "banInput"
        );


    const username =
        cleanUsername(
            input.value
        );


    if (!username) {

        showAdminMessage(
            "Enter a username to ban."
        );

        return;

    }


    if (
        usernameKey(username) ===
        usernameKey(ADMIN_USERNAME)
    ) {

        showAdminMessage(
            "You cannot ban the creator."
        );

        return;

    }


    const banned =
        getBannedUsers();


    const key =
        usernameKey(username);


    if (!banned.includes(key)) {

        banned.push(key);

    }


    saveBannedUsers(banned);


    showAdminMessage(
        "🔨 " + username +
        " has been banned."
    );


    input.value = "";


    /* If currently logged-in user is banned
       somehow, log them out. */

    if (
        currentUser &&
        usernameKey(currentUser.username) === key
    ) {

        logout();

    }

}


/* =========================
   UNBAN USER
========================= */

function unbanUser() {

    if (!isAdmin()) {
        return;
    }


    const input =
        document.getElementById(
            "unbanInput"
        );


    const username =
        cleanUsername(
            input.value
        );


    if (!username) {

        showAdminMessage(
            "Enter a username to unban."
        );

        return;

    }


    const key =
        usernameKey(username);


    let banned =
        getBannedUsers();


    banned =
        banned.filter(
            user =>
                user !== key
        );


    saveBannedUsers(banned);


    showAdminMessage(
        "🔓 " + username +
        " has been unbanned."
    );


    input.value = "";

}


