<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>David AI</title>

<style>
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    background: #212121;
    color: #fff;
}

body {
    overflow: hidden;
}

/* =========================
   LOGIN SCREEN
========================= */

#loginScreen {
    height: 100vh;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background:
        radial-gradient(circle at top left, #343434, transparent 40%),
        radial-gradient(circle at bottom right, #181818, transparent 45%),
        #171717;
    padding: 20px;
}

.loginBox {
    width: 100%;
    max-width: 430px;
    background: #242424;
    border: 1px solid #3d3d3d;
    border-radius: 22px;
    padding: 35px;
    box-shadow: 0 20px 60px rgba(0,0,0,.45);
    text-align: center;
}

.loginLogo {
    font-size: 58px;
    margin-bottom: 5px;
}

.loginBox h1 {
    margin: 0;
    font-size: 32px;
}

.loginBox .subtitle {
    color: #aaa;
    margin: 8px 0 30px;
}

.usernameInput {
    width: 100%;
    padding: 15px 17px;
    border-radius: 12px;
    border: 1px solid #4a4a4a;
    background: #181818;
    color: white;
    font-size: 16px;
    outline: none;
}

.usernameInput:focus {
    border-color: #777;
}

.joinButton {
    width: 100%;
    margin-top: 12px;
    padding: 15px;
    border: none;
    border-radius: 12px;
    background: #fff;
    color: #111;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: .15s;
}

.joinButton:hover {
    transform: translateY(-1px);
    background: #e8e8e8;
}

.loginHint {
    margin-top: 18px;
    color: #777;
    font-size: 13px;
}

.loginError {
    color: #ff7373;
    margin-top: 12px;
    min-height: 20px;
}

/* =========================
   MAIN APP
========================= */

#app {
    display: none;
    height: 100vh;
    width: 100%;
}

/* Sidebar */

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 260px;
    background: #171717;
    border-right: 1px solid #303030;
    display: flex;
    flex-direction: column;
    z-index: 20;
}

.sidebarTop {
    padding: 18px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 18px;
}

.logoEmoji {
    font-size: 25px;
}

.newChat {
    width: 100%;
    border: 1px solid #444;
    background: #222;
    color: white;
    border-radius: 10px;
    padding: 12px;
    cursor: pointer;
    text-align: left;
    font-size: 14px;
}

.newChat:hover {
    background: #2d2d2d;
}

.sidebarSection {
    padding: 10px 18px;
    color: #888;
    font-size: 12px;
}

.sidebarUser {
    margin-top: auto;
    border-top: 1px solid #303030;
    padding: 14px;
}

.userCard {
    background: #222;
    border-radius: 10px;
    padding: 12px;
}

.userName {
    font-weight: 600;
    word-break: break-word;
}

.userStatus {
    color: #777;
    font-size: 12px;
    margin-top: 4px;
}

.logoutButton,
.adminButton {
    width: 100%;
    margin-top: 9px;
    padding: 10px;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    color: white;
    background: #303030;
}

.logoutButton:hover,
.adminButton:hover {
    background: #3a3a3a;
}

.adminButton {
    display: none;
}

/* Main */

.main {
    margin-left: 260px;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: #212121;
}

/* Header */

.header {
    height: 60px;
    flex-shrink: 0;
    border-bottom: 1px solid #303030;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    background: rgba(33,33,33,.95);
}

.headerTitle {
    font-weight: 600;
}

.smartBadge {
    display: none;
    padding: 5px 9px;
    border-radius: 8px;
    background: #343434;
    color: #ddd;
    font-size: 12px;
}

/* Chat */

.chatArea {
    flex: 1;
    overflow-y: auto;
    padding-bottom: 120px;
}

.message {
    max-width: 850px;
    margin: 0 auto;
    padding: 24px 24px;
    display: flex;
    gap: 15px;
}

.message.userMessage {
    background: transparent;
}

.messageIcon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 8px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #303030;
}

.message.userMessage .messageIcon {
    background: #555;
}

.messageContent {
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.messageName {
    font-weight: 700;
    margin-bottom: 4px;
}

.aiName {
    color: #eee;
}

.userNameLabel {
    color: #ddd;
}

.typing {
    color: #aaa;
}

.dot {
    animation: blink 1.4s infinite;
}

.dot:nth-child(2) {
    animation-delay: .2s;
}

.dot:nth-child(3) {
    animation-delay: .4s;
}

@keyframes blink {
    0%, 80%, 100% {
        opacity: .2;
    }
    40% {
        opacity: 1;
    }
}

/* Empty welcome */

.welcome {
    max-width: 850px;
    margin: 0 auto;
    min-height: 65%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 30px;
}

.welcomeEmoji {
    font-size: 55px;
}

.welcome h1 {
    font-size: 32px;
    margin: 12px 0 5px;
}

.welcome p {
    color: #999;
    max-width: 550px;
}

/* Input */

.inputArea {
    position: fixed;
    left: 260px;
    right: 0;
    bottom: 0;
    padding: 18px 20px 22px;
    background: linear-gradient(
        transparent,
        #212121 25%
    );
}

.inputBox {
    max-width: 850px;
    margin: 0 auto;
    background: #2f2f2f;
    border: 1px solid #484848;
    border-radius: 17px;
    display: flex;
    align-items: flex-end;
    padding: 8px;
    box-shadow: 0 5px 25px rgba(0,0,0,.25);
}

#messageInput {
    flex: 1;
    resize: none;
    min-height: 42px;
    max-height: 160px;
    padding: 10px 12px;
    border: none;
    outline: none;
    background: transparent;
    color: white;
    font-size: 15px;
    font-family: inherit;
}

#messageInput::placeholder {
    color: #888;
}

.sendButton {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: none;
    background: #fff;
    color: #111;
    font-size: 18px;
    cursor: pointer;
}

.sendButton:hover {
    background: #ddd;
}

.sendButton:disabled {
    opacity: .35;
    cursor: default;
}

.disclaimer {
    max-width: 850px;
    margin: 7px auto 0;
    text-align: center;
    font-size: 11px;
    color: #666;
}

/* =========================
   ADMIN PANEL
========================= */

#adminOverlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.72);
    z-index: 100;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.adminPanel {
    width: 100%;
    max-width: 550px;
    max-height: 90vh;
    overflow-y: auto;
    background: #242424;
    border: 1px solid #444;
    border-radius: 18px;
    padding: 25px;
    box-shadow: 0 30px 80px rgba(0,0,0,.6);
}

.adminHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.adminHeader h2 {
    margin: 0;
}

.closeAdmin {
    background: #333;
    border: none;
    color: white;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    cursor: pointer;
}

.adminGroup {
    margin-top: 22px;
}

.adminGroup h3 {
    font-size: 14px;
    color: #aaa;
}

.adminInput {
    width: 100%;
    padding: 12px;
    border-radius: 9px;
    border: 1px solid #444;
    background: #181818;
    color: white;
    outline: none;
}

.adminAction {
    margin-top: 9px;
    width: 100%;
    padding: 11px;
    border: none;
    border-radius: 9px;
    background: #333;
    color: white;
    cursor: pointer;
}

.adminAction:hover {
    background: #414141;
}

.smartToggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #1d1d1d;
    padding: 14px;
    border-radius: 10px;
}

.switch {
    width: 48px;
    height: 26px;
    background: #555;
    border-radius: 30px;
    position: relative;
    cursor: pointer;
}

.switch::after {
    content: "";
    position: absolute;
    width: 20px;
    height: 20px;
    top: 3px;
    left: 4px;
    background: white;
    border-radius: 50%;
    transition: .2s;
}

.switch.on {
    background: #777;
}

.switch.on::after {
    left: 24px;
}

.adminMessage {
    margin-top: 12px;
    color: #aaa;
    font-size: 13px;
}

/* =========================
   MOBILE
========================= */

.mobileMenu {
    display: none;
}

@media (max-width: 700px) {

    .sidebar {
        transform: translateX(-100%);
        transition: .2s;
        width: 280px;
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .main {
        margin-left: 0;
    }

    .inputArea {
        left: 0;
    }

    .mobileMenu {
        display: block;
        background: transparent;
        color: white;
        border: none;
        font-size: 22px;
        cursor: pointer;
        margin-right: 10px;
    }

    .header {
        justify-content: flex-start;
    }

    .message {
        padding: 18px 14px;
    }

    .welcome h1 {
        font-size: 27px;
    }

    .loginBox {
        padding: 27px 20px;
    }
}
</style>
</head>

<body>

<!-- =========================
     LOGIN
========================= -->

<div id="loginScreen">

    <div class="loginBox">

        <div class="loginLogo">🤪</div>

        <h1>David AI</h1>

        <div class="subtitle">
            The World's Least Intelligent AI
        </div>

        <input
            id="usernameInput"
            class="usernameInput"
            type="text"
            maxlength="24"
            placeholder="Enter your username"
            autocomplete="off"
        >

        <button class="joinButton" onclick="joinDavid()">
            Enter David AI
        </button>

        <div id="loginError" class="loginError"></div>

        <div class="loginHint">
            No password. Just pick a username and enter.
        </div>

    </div>

</div>


<!-- =========================
     APP
========================= -->

<div id="app">

    <aside class="sidebar" id="sidebar">

        <div class="sidebarTop">

            <div class="logo">
                <span class="logoEmoji">🤪</span>
                <span>David AI</span>
            </div>

            <button class="newChat" onclick="newChat()">
                ＋ New chat
            </button>

        </div>

        <div class="sidebarSection">
            David 2.0
        </div>

        <div class="sidebarUser">

            <div class="userCard">

                <div class="userName" id="sidebarUsername">
                    User
                </div>

                <div class="userStatus">
                    🟢 Online
                </div>

            </div>

            <button
                id="adminButton"
                class="adminButton"
                onclick="openAdmin()">
                ⚙️ Admin Panel
            </button>

            <button
                class="logoutButton"
                onclick="logout()">
                Log out
            </button>

        </div>

    </aside>


    <main class="main">

        <header class="header">

            <button
                class="mobileMenu"
                onclick="toggleSidebar()">
                ☰
            </button>

            <div class="headerTitle">
                David 2.0
            </div>

            <div
                id="smartBadge"
                class="smartBadge">
                🧠 Smart Mode
            </div>

        </header>


        <section
            class="chatArea"
            id="chatArea">

            <div
                class="welcome"
                id="welcome">

                <div class="welcomeEmoji">
                    🤪
                </div>

                <h1>How can David help?</h1>

                <p>
                    Hello! I am David, an extremely advanced
                    artificial intelligence trained on approximately
                    3 potatoes.
                </p>

            </div>

        </section>


        <div class="inputArea">

            <div class="inputBox">

                <textarea
                    id="messageInput"
                    rows="1"
                    placeholder="Message David..."
                    onkeydown="handleKey(event)"
                    oninput="resizeInput(this)"
                ></textarea>

                <button
                    class="sendButton"
                    id="sendButton"
                    onclick="sendMessage()">
                    ↑
                </button>

            </div>

            <div class="disclaimer">
                David can make mistakes. In fact, he probably will.
            </div>

        </div>

    </main>

</div>


<!-- =========================
     ADMIN OVERLAY
========================= -->

<div id="adminOverlay">

    <div class="adminPanel">

        <div class="adminHeader">

            <h2>⚙️ David Admin</h2>

            <button
                class="closeAdmin"
                onclick="closeAdmin()">
                ×
            </button>

        </div>


        <div class="adminGroup">

            <h3>Smart Mode</h3>

            <div class="smartToggle">

                <span>
                    🧠 Enable Smart Mode
                </span>

                <div
                    id="smartSwitch"
                    class="switch"
                    onclick="toggleSmartMode()">
                </div>

            </div>

        </div>


        <div class="adminGroup">

            <h3>Ban a user</h3>

            <input
                id="banInput"
                class="adminInput"
                placeholder="Username">

            <button
                class="adminAction"
                onclick="banUser()">
                🔨 Ban user
            </button>

        </div>


        <div class="adminGroup">

            <h3>Unban a user</h3>

            <input
                id="unbanInput"
                class="adminInput"
                placeholder="Username">

            <button
                class="adminAction"
                onclick="unbanUser()">
                🔓 Unban user
            </button>

        </div>


        <div class="adminGroup">

            <h3>System</h3>

            <button
                class="adminAction"
                onclick="showSystemInfo()">
                🖥️ System information
            </button>

        </div>


        <div
            id="adminMessage"
            class="adminMessage">
        </div>

    </div>

</div>


<script>

/* =====================================================
   DAVID AI 2.0
   USERNAME-ONLY LOGIN SYSTEM
===================================================== */


/* =========================
   CONFIG
========================= */

const ADMIN_USERNAME = "NeonWarlock0992";

let currentUser = null;
let smartMode = false;


/* =========================
   LOCAL STORAGE DATABASE
========================= */

function getAccounts() {

    try {

        return JSON.parse(
            localStorage.getItem("davidAccounts") || "{}"
        );

    } catch {

        return {};

    }

}


function saveAccounts(accounts) {

    localStorage.setItem(
        "davidAccounts",
        JSON.stringify(accounts)
    );

}


function getBannedUsers() {

    try {

        return JSON.parse(
            localStorage.getItem("davidBannedUsers") || "[]"
        );

    } catch {

        return [];

    }

}


function saveBannedUsers(users) {

    localStorage.setItem(
        "davidBannedUsers",
        JSON.stringify(users)
    );

}


/* =========================
   USERNAME CLEANING
========================= */

function cleanUsername(name) {

    return name
        .trim()
        .replace(/\s+/g, " ");

}


function usernameKey(name) {

    return cleanUsername(name).toLowerCase();

}


/* =========================
   LOGIN
========================= */

function joinDavid() {

    const input =
        document.getElementById("usernameInput");

    const error =
        document.getElementById("loginError");

    const username =
        cleanUsername(input.value);

    error.textContent = "";


    if (!username) {

        error.textContent =
            "Please enter a username.";

        return;

    }


    if (username.length < 2) {

        error.textContent =
            "Your username needs at least 2 characters.";

        return;

    }


    if (username.length > 24) {

        error.textContent =
            "That username is too long.";

        return;

    }


    const key = usernameKey(username);

    const banned =
        getBannedUsers();

    if (banned.includes(key)) {

        error.textContent =
            "🚫 This username is banned.";

        return;

    }


    const accounts =
        getAccounts();


    if (!accounts[key]) {

        accounts[key] = {

            username: username,

            created:
                new Date().toISOString(),

            messages: []

        };

        saveAccounts(accounts);

    }


    currentUser = accounts[key];

    localStorage.setItem(
        "davidCurrentUser",
        key
    );


    loadApp();

}


/* =========================
   LOAD APP
========================= */

function loadApp() {

    if (!currentUser) {
        return;
    }


    document.getElementById(
        "loginScreen"
    ).style.display = "none";


    document.getElementById(
        "app"
    ).style.display = "block";


    document.getElementById(
        "sidebarUsername"
    ).textContent =
        currentUser.username;


    if (
        usernameKey(currentUser.username) ===
        usernameKey(ADMIN_USERNAME)
    ) {

        document.getElementById(
            "adminButton"
        ).style.display = "block";

    }


    restoreChat();

}


/* =========================
   RESTORE SESSION
========================= */

function restoreSession() {

    const saved =
        localStorage.getItem(
            "davidCurrentUser"
        );

    if (!saved) {
        return;
    }


    const banned =
        getBannedUsers();

    if (banned.includes(saved)) {

        localStorage.removeItem(
            "davidCurrentUser"
        );

        return;

    }


    const accounts =
        getAccounts();

    if (!accounts[saved]) {
        return;
    }


    currentUser =
        accounts[saved];

    loadApp();

}


restoreSession();


/* =========================
   LOGOUT
========================= */

function logout() {

    localStorage.removeItem(
        "davidCurrentUser"
    );

    currentUser = null;


    document.getElementById(
        "app"
    ).style.display = "none";


    document.getElementById(
        "loginScreen"
    ).style.display = "flex";


    document.getElementById(
        "usernameInput"
    ).value = "";


    document.getElementById(
        "loginError"
    ).textContent = "";

}


/* =========================
   NEW CHAT
========================= */

function newChat() {

    const chat =
        document.getElementById(
            "chatArea"
        );


    chat.innerHTML = `

        <div class="welcome" id="welcome">

            <div class="welcomeEmoji">
                🤪
            </div>

            <h1>New David chat</h1>

            <p>
                David has forgotten everything.
                Probably for the best.
            </p>

        </div>

    `;

}


/* =========================
   CHAT RESTORE
========================= */

function restoreChat() {

    const chat =
        document.getElementById(
            "chatArea"
        );


    chat.innerHTML = "";


    if (
        currentUser.messages &&
        currentUser.messages.length > 0
    ) {

        currentUser.messages.forEach(
            message => {

                addMessage(
                    message.sender,
                    message.text,
                    false
                );

            }
        );

    } else {

        chat.innerHTML = `

            <div class="welcome" id="welcome">

                <div class="welcomeEmoji">
                    🤪
                </div>

                <h1>How can David help?</h1>

                <p>
                    Hello! I am David, an extremely advanced
                    artificial intelligence trained on approximately
                    3 potatoes.
                </p>

            </div>

        `;

    }

}


/* =========================
   SAVE MESSAGE
========================= */

function saveMessage(sender, text) {

    if (!currentUser) {
        return;
    }


    const accounts =
        getAccounts();


    const key =
        usernameKey(
            currentUser.username
        );


    if (!accounts[key]) {
        return;
    }


    if (!accounts[key].messages) {

        accounts[key].messages = [];

    }


    accounts[key].messages.push({

        sender: sender,

        text: text,

        time:
            new Date().toISOString()

    });


    currentUser =
        accounts[key];


    saveAccounts(accounts);

}


/* =========================
   ADD MESSAGE
========================= */

function addMessage(
    sender,
    text,
    save = true
) {

    const chat =
        document.getElementById(
            "chatArea"
        );


    const welcome =
        document.getElementById(
            "welcome"
        );

    if (welcome) {
        welcome.remove();
    }


    const message =
        document.createElement(
            "div"
        );


    message.className =
        "message " +
        (sender === "user"
            ? "userMessage"
            : "aiMessage");


    const icon =
        sender === "user"
            ? "👤"
            : "🤪";


    const name =
        sender === "user"
            ? currentUser.username
            : "David";


    message.innerHTML = `

        <div class="messageIcon">
            ${icon}
        </div>

        <div class="messageContent">

            <div class="messageName
                ${sender === "user"
                    ? "userNameLabel"
                    : "aiName"}">

                ${escapeHTML(name)}

            </div>

            <div>
                ${escapeHTML(text)}
            </div>

        </div>

    `;


    chat.appendChild(message);


    chat.scrollTop =
        chat.scrollHeight;


    if (save) {

        saveMessage(
            sender,
            text
        );

    }

}


/* =========================
   ESCAPE HTML
========================= */

function escapeHTML(text) {

    const div =
        document.createElement(
            "div"
        );

    div.textContent =
        text;

    return div.innerHTML;

}


/* =========================
   SEND MESSAGE
========================= */

function sendMessage() {

    const input =
        document.getElementById(
            "messageInput"
        );


    const text =
        input.value.trim();


    if (!text) {
        return;
    }


    input.value = "";

    resizeInput(input);


    addMessage(
        "user",
        text
    );


    showTyping();


    setTimeout(
        () => {

            removeTyping();


            const response =
                getDavidResponse(text);


            addMessage(
                "ai",
                response
            );

        },
        450 +
        Math.random() * 650
    );

}


/* =========================
   ENTER KEY
========================= */

function handleKey(event) {

    if (
        event.key === "Enter" &&
        !event.shiftKey
    ) {

        event.preventDefault();

        sendMessage();

    }

}


/* =========================
   INPUT RESIZE
========================= */

function resizeInput(element) {

    element.style.height =
        "auto";

    element.style.height =
        Math.min(
            element.scrollHeight,
            160
        ) + "px";

